# HomeStew Configuration
# Copy this file to .env and customize as needed
#
# NOTE: This file is for non-secret configuration (URLs, model names).
# Prefer entering API keys/tokens in the Settings UI - they are encrypted at
# rest with the secrets master key (see README "Secrets") instead of sitting
# in a plaintext dotfile. Only use LLM_API_KEY here for local dev convenience.

# LLM Configuration
# For local Ollama (default):
LLM_BASE_URL=http://localhost:11434/v1
# Local servers ignore the key - leave it unset unless you need one.
# LLM_API_KEY=
LLM_MODEL=llama3.2

# For OpenAI (uncomment and modify):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-openai-api-key-here
# LLM_MODEL=gpt-4o-mini

# For other OpenAI-compatible servers:
# LLM_BASE_URL=http://your-server:8080/v1
# LLM_API_KEY=your-api-key
# LLM_MODEL=your-model-name

# Application Settings (optional)
# DEBUG=true
# HOST=0.0.0.0
# PORT=8000
